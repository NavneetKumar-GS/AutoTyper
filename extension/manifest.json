{
  "manifest_version": 3,
  "name": "AutoTyper HUD",
  "version": "1.0",
  "description": "Visual calibration, Start, and Stop controls for AutoTyper.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}